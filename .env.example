# Nusxa oling: cp .env.example .env
# .env gitignore'da — secret'lar hech qachon repo'ga tushmasin.

# --- GitHub OAuth (ixtiyoriy) --------------------------------------------
# Bo'sh qoldirsangiz parol bilan kirish ishlayveradi: admin/demo yoki user/demo
#
# Olish: github.com/settings/developers → New OAuth App
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:5173/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Auth dev-server ------------------------------------------------------
# AUTH_PORT=4000
# APP_ORIGIN=http://localhost:5173
# AUTH_SECRET=dev-only-secret-do-not-use-in-prod

# Access token TTL. Dev'da 30s — refresh'ni DevTools'da jonli ko'rish uchun.
# ACCESS_TTL_S=30
